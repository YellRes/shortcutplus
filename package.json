{
  "name": "altswitch",
  "productName": "AltSwitch",
  "private": true,
  "version": "0.1.0",
  "description": "A fast, keyboard-first Alt+Tab replacement for Windows — a Spotlight-style window switcher.",
  "author": "Glider",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/YellRes/shortcutplus.git"
  },
  "homepage": "https://github.com/YellRes/shortcutplus#readme",
  "type": "module",
  "main": "dist/main/index.cjs",
  "scripts": {
    "preview": "vite preview",
    "dev:renderer": "vite serve packages/renderer",
    "build:renderer": "vue-tsc -p packages/renderer/tsconfig.json --noEmit && vite build packages/renderer",
    "build:preload": "tsc -p packages/preload/tsconfig.json --noEmit && vite build packages/preload",
    "build:main": "tsc -p packages/main/tsconfig.json --noEmit && vite build packages/main",
    "build": "npm run build:renderer && npm run build:preload && npm run build:main",
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development tsx scripts/dev-server.ts",
    "dist": "pnpm run build && electron-builder ",
    "dist:dir": "pnpm run build && electron-builder --dir"
  },
  "build": {
    "appId": "com.altswitch.app",
    "productName": "AltSwitch",
    "directories": {
      "output": "release"
    },
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "files": [
      "dist/**/*",
      "!dist/**/*.map",
      "package.json",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**"
    ],
    "extraResources": [
      "asset/**"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "asset/image/app-icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@ant-design/icons-vue": "^6.1.0",
    "koffi": "^2.12.0",
    "pinyin-pro": "^3.26.0",
    "vue": "^3.2.41",
    "vue-router": "^4.1.6"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.1.4",
    "@types/node": "16",
    "@vitejs/plugin-vue": "^3.2.0",
    "@vue/eslint-config-prettier": "^7.0.0",
    "@vue/eslint-config-typescript": "^11.0.0",
    "autoprefixer": "^10.4.15",
    "cross-env": "^7.0.3",
    "electron": "^19.0.0",
    "electron-builder": "^26.8.1",
    "eslint": "^8.9.0",
    "eslint-plugin-vue": "^9.3.0",
    "husky": "^7.0.0",
    "less": "^4.1.3",
    "lint-staged": "^11.2.6",
    "postcss": "^8.4.28",
    "prettier": "2.6.0",
    "tailwindcss": "^3.3.3",
    "terser": "^5.16.1",
    "tsx": "^4.19.2",
    "typescript": "^4.6.4",
    "vite": "^4.4.9",
    "vue-tsc": "^1.0.9"
  },
  "lint-staged": {
    "packages/**/src/**/*.{js,jsx,ts,tsx,vue,json}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
